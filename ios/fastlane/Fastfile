require "base64"
require "securerandom"

default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Sanity-check the key via fastlane's own (spaceship) ASC client, which is
    # independent of xcodebuild's built-in -authenticationKeyPath auth. If this
    # fails too, the ASC_KEY_ID/ASC_ISSUER_ID/ASC_KEY_CONTENT secrets themselves
    # are the problem, not the xcodebuild provisioning-update flow.
    build_number = latest_testflight_build_number(api_key: api_key)
    UI.success("ASC API key check passed (latest TestFlight build: #{build_number})")

    # -allowProvisioningUpdates can fetch/create profiles via the api key, but it
    # can't obtain the private key of a manually-created Distribution certificate,
    # so import that cert into a throwaway CI keychain before archiving.
    keychain_name = "isusm-ci.keychain-db"
    keychain_password = SecureRandom.hex(16)
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 1800
    )

    cert_path = File.expand_path("dist_cert.p12")
    File.write(cert_path, Base64.decode64(ENV["IOS_DIST_CERT_P12"]))

    begin
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV["IOS_DIST_CERT_PASSWORD"].to_s.strip,
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
    ensure
      File.delete(cert_path) if File.exist?(cert_path)
    end

    identity_output = sh("security find-identity -v -p codesigning #{keychain_name.shellescape}")
    UI.user_error!("Distribution certificate import failed; verify IOS_DIST_CERT_P12 and IOS_DIST_CERT_PASSWORD.") if identity_output.include?("0 valid identities found")
    UI.message(identity_output)

    # Automatic signing's -allowProvisioningUpdates could never successfully create
    # a distribution profile for this team, so install the manually-generated App
    # Store profile instead and build with manual signing (no live Apple call needed).
    profile_path = File.expand_path("distribution.mobileprovision")
    File.write(profile_path, Base64.decode64(ENV["IOS_PROVISIONING_PROFILE"]))

    profile_uuid = nil
    begin
      install_provisioning_profile(path: profile_path)
      plist_path = File.expand_path("distribution_profile.plist")
      sh("security cms -D -i #{profile_path.shellescape} -o #{plist_path.shellescape}")
      profile_uuid = sh("/usr/libexec/PlistBuddy -c 'Print UUID' #{plist_path.shellescape}").strip
      File.delete(plist_path) if File.exist?(plist_path)
    ensure
      File.delete(profile_path) if File.exist?(profile_path)
    end

    begin
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        export_method: "app-store",
        export_options: {
          provisioningProfiles: {
            "edu.iastate.mesonet.isusmApp" => profile_uuid
          }
        },
        xcargs: "FLUTTER_BUILD_NUMBER=#{ENV["GITHUB_RUN_NUMBER"]} " \
                "DEVELOPMENT_TEAM=#{ENV["APPLE_TEAM_ID"]} " \
                "CODE_SIGN_STYLE=Manual " \
                "CODE_SIGN_IDENTITY=Apple\\ Distribution " \
                "IOS_PROVISIONING_PROFILE_UUID=#{profile_uuid}"
      )
    ensure
      delete_keychain(name: keychain_name)
    end

    upload_to_testflight(api_key: api_key)
  end
end
